# Mipoe Frontend Environment Configuration Example
# Copy this file to '.env' or '.env.local' and customize the value.

# The base URL of the Mipoe Backend API.
# Examples:
# - Local Development: http://localhost:5000
# - Production/Ngrok Tunnel: https://enrich-prominent-backspace.ngrok-free.dev
VITE_API_BASE_URL=http://localhost:5000

# Web 2.5 Authentication: Okto by CoinDCX (from https://dashboard.okto.tech)
VITE_OKTO_CLIENT_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Web 2.5 Payments: Onramp App ID (optional, fallback from backend)
VITE_ONRAMP_APP_ID=
